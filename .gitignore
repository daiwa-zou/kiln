# Binaries (anchored: a bare `kiln` would also match cmd/kiln/)
/bin/
/dist/
/kiln

# Go
*.test
*.out
# Anchored: an unanchored `coverage.*` also matches .github/badges/coverage.svg,
# which is a committed artifact, not build output.
/coverage.*

# Node / Next.js
node_modules/
web/.next/
web/out/
web/.turbo/

# Local state
.env
.env.local
*.local.toml
/tmp/
/blobs/

# Editors / OS
.DS_Store
.idea/
*.swp
.claude/
