# Copy to .env and fill in before `docker compose up`.
#
# Every kiln setting binds to an environment variable: the config key with a
# KILN_ prefix and dots replaced by underscores (agent.model ->
# KILN_AGENT_MODEL). Secrets additionally accept a _FILE suffix pointing at a
# mounted file (KILN_MASTER_KEY_FILE), which is how Docker and Kubernetes
# secrets should be delivered in production rather than inline values.

# --- required ---------------------------------------------------------------

# Seals connector credentials at rest (AES-256-GCM). Generate with:
#   openssl rand -hex 32
# Losing it makes stored credentials unrecoverable; rotate with
# `kiln admin rotate-key`.
KILN_MASTER_KEY=

# Spent by the generation pipeline. Omit only if every bench uses
# agent.runner = "fake" (deterministic placeholder prose, zero spend).
KILN_ANTHROPIC_API_KEY=

# --- recommended ------------------------------------------------------------

# The compose stack authenticates by default. Mint the first token once the
# stack is up, then paste it when the UI asks:
#   docker compose exec api kiln admin token create --login you --scopes read,write,admin
#
# The port publishes to loopback only; widen it once you are behind TLS.
# KILN_BIND_ADDR=0.0.0.0
# KILN_PUBLIC_URL=https://kiln.example.com

# POSTGRES_PASSWORD=change-me
# MINIO_ROOT_USER=kilnminio
# MINIO_ROOT_PASSWORD=change-me

# --- optional ---------------------------------------------------------------

# KILN_LOG_LEVEL=info

# Prometheus metrics listener. Separate from the API port so it is never
# published through an ingress; empty disables it.
# KILN_METRICS_ADDR=:9090
# KILN_IMAGE=ghcr.io/daiwa-zou/kiln:v0.1.0

# Per-run and per-workspace spend caps.
# KILN_AGENT_RUN_BUDGET_USD=5.00
# KILN_AGENT_MAX_PAGES_PER_RUN=25

# GitHub sign-in and webhook ingress (see docs/deployment.md).
# KILN_GITHUB_CLIENT_ID=
# KILN_GITHUB_CLIENT_SECRET=
# KILN_GITHUB_APP_ID=
# KILN_GITHUB_PRIVATE_KEY_FILE=/run/secrets/github-app-key.pem
# KILN_GITHUB_WEBHOOK_SECRET=
