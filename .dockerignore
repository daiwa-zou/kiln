# The build needs source and go.mod/go.sum; everything else only slows the
# context upload and busts the layer cache.
.git
.github
.claude
bin/
dist/
/kiln
.dev/
blobs/
coverage.*
*.test
node_modules/
# The UI's sources and toolchain. The image embeds the committed build
# (internal/api/ui/dist, which the root-anchored dist/ above does not match).
web/
.env
.env.local
*.local.toml
.DS_Store
.idea/
*.swp
deploy/
docs/
*.md
!README.md
